<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Planimetría Fin de Año Uniandes</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<style id="app-css">
/* Noche dorada: el mapa ocupa todo el ancho con íconos encima; cada ícono abre una ventana con fotos. */
:root{
  --night:#0c1322;
  --panel:#131c2f;
  --raise:#1a2540;
  --line:#2a3653;
  --ink:#eef1f7;
  --muted:#9ba7c0;
  --gold:#e4bb5f;
  --gold-soft:rgba(228,187,95,.14);
  --danger:#f07a6a;
  --f-display:"Cormorant Garamond","Iowan Old Style",Georgia,serif;
  --f-body:"Manrope","Segoe UI",system-ui,-apple-system,sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--night);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.5}
body.locked{overflow:hidden}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
img{max-width:100%;display:block}
.wrap{max-width:1480px;margin:0 auto;padding:0 clamp(16px,3vw,32px)}

/* Encabezado */
.top{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px 24px;padding-top:22px;padding-bottom:16px}
.eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:600;margin:0 0 4px}
.top h1{font-family:var(--f-display);font-weight:600;font-style:italic;font-size:clamp(28px,3.6vw,40px);line-height:1.1;margin:0;text-wrap:balance}
.top .sub{color:var(--muted);margin:4px 0 0;font-size:14px}
.top-actions{display:flex;flex-wrap:wrap;gap:8px}
.btn{border:1px solid var(--line);background:var(--raise);border-radius:8px;padding:8px 14px;font-size:14px;font-weight:600;display:inline-flex;align-items:center;gap:6px;text-decoration:none;color:var(--ink)}
.btn:hover{border-color:var(--gold)}
.btn.primary{background:var(--gold);color:#1b1404;border-color:var(--gold)}
.btn.ghost{background:transparent}
.btn.danger{color:var(--danger);background:transparent;border-color:rgba(240,122,106,.4)}
.btn.small{padding:5px 10px;font-size:13px}
.btn[disabled]{opacity:.5;cursor:not-allowed}

.editbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;padding:10px 14px;margin-bottom:12px;background:var(--gold-soft);border:1px solid rgba(228,187,95,.35);border-radius:10px;font-size:14px}
.editbar .msg{flex:1 1 260px}
.status{padding:8px 14px;margin-bottom:12px;font-size:14px;border-radius:10px;border:1px solid var(--line)}
.status.err{color:var(--danger)}
.status.ok{color:#7fd6a0}

/* Mapa */
.mapscroll{overflow-x:auto;border-radius:14px;border:1px solid var(--line)}
.map{position:relative;width:100%;min-width:900px;aspect-ratio:1366/738;background:#1b2a1d;user-select:none}
.map>img{width:100%;height:100%;object-fit:cover;pointer-events:none}
.map.placing{cursor:crosshair}
.hint{color:var(--muted);font-size:13px;margin:8px 0 0}

.mk{position:absolute;transform:translate(-50%,-50%);width:clamp(30px,2.7vw,38px);height:clamp(30px,2.7vw,38px);border-radius:50%;border:2px solid #fff;background:var(--c);color:#0f1420;display:grid;place-items:center;padding:0;box-shadow:0 3px 12px rgba(0,0,0,.55);transition:transform .15s}
.mk svg{width:56%;height:56%}
.mk .no{position:absolute;right:-6px;bottom:-5px;min-width:17px;height:17px;padding:0 4px;border-radius:9px;background:#0c1322;color:var(--gold);border:1px solid var(--gold);font-size:10px;font-weight:700;line-height:15px;text-align:center}
.mk .tag{position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);white-space:nowrap;background:rgba(12,19,34,.94);color:var(--ink);font-weight:600;font-size:12px;padding:3px 9px;border-radius:6px;border:1px solid var(--line);opacity:0;pointer-events:none;transition:opacity .15s}
.mk:hover,.mk:focus-visible{transform:translate(-50%,-50%) scale(1.15);z-index:4}
.mk:hover .tag,.mk:focus-visible .tag{opacity:1}
.editing .mk{cursor:grab;outline:2px dashed rgba(255,255,255,.7);outline-offset:3px}
@media (prefers-reduced-motion:reduce){.mk,.mk .tag{transition:none}}

/* Índice de puntos bajo el mapa */
.pts{display:flex;flex-direction:column;gap:12px;margin-top:18px}
.ptgroup{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.ptgroup h3{margin:0 6px 0 0;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:700;display:inline-flex;align-items:center;gap:7px;min-width:190px}
.dot{width:10px;height:10px;border-radius:50%;flex:none}
.pt{display:inline-flex;align-items:center;gap:8px;background:var(--raise);border:1px solid var(--line);border-radius:999px;padding:4px 12px 4px 4px;font-size:13px;font-weight:600}
.pt:hover{border-color:var(--gold)}
.pt i{width:24px;height:24px;border-radius:50%;background:var(--c);color:#0f1420;display:grid;place-items:center}
.pt i svg{width:14px;height:14px}

/* Ventana del punto */
.modal{position:fixed;inset:0;z-index:40;background:rgba(5,8,15,.82);display:grid;place-items:center;padding:clamp(10px,3vw,32px)}
.box{width:min(1080px,100%);max-height:100%;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:16px;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);box-shadow:0 20px 60px rgba(0,0,0,.6)}
.gal{background:#080c16;display:flex;flex-direction:column;min-width:0}
.stage{position:relative;aspect-ratio:4/3;background:#080c16}
.stage img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
.stage .nav{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;background:rgba(19,28,47,.9);border:1px solid var(--line);font-size:22px;line-height:1}
.stage .nav:hover{border-color:var(--gold)}
.stage .prev{left:10px}.stage .next{right:10px}
.stage .count{position:absolute;left:10px;bottom:10px;background:rgba(12,19,34,.85);font-size:12px;font-weight:700;color:var(--gold);padding:2px 8px;border-radius:6px}
.cap{padding:10px 14px 12px;border-top:1px solid var(--line)}
.cap b{display:block;font-size:14px}
.cap span{color:var(--muted);font-size:13px}
.thumbs{display:flex;gap:6px;padding:0 14px 14px;overflow-x:auto}
.thumbs button{flex:none;width:72px;height:54px;padding:0;border:2px solid transparent;border-radius:6px;overflow:hidden;background:none;opacity:.7}
.thumbs button.on{border-color:var(--gold);opacity:1}
.thumbs img{width:100%;height:100%;object-fit:cover}
.nophoto{display:grid;place-items:center;aspect-ratio:4/3;color:var(--muted);font-size:14px;padding:20px;text-align:center}
.info{padding:22px 22px 24px;display:flex;flex-direction:column;gap:14px;position:relative;min-width:0}
.info h2{font-family:var(--f-display);font-weight:600;font-size:30px;line-height:1.1;margin:0;padding-right:40px;text-wrap:balance}
.chip{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--muted)}
.info .desc{margin:0;white-space:pre-wrap}
.info h3{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);margin:0;font-weight:700}
.notes{border:1px dashed var(--line);border-radius:10px;padding:12px 14px}
.notes p{margin:6px 0 0;white-space:pre-wrap}
.notes .empty{color:var(--muted);font-size:14px}
.x{position:absolute;top:14px;right:14px;width:34px;height:34px;border-radius:50%;background:var(--raise);border:1px solid var(--line);font-size:16px}
.x:hover{border-color:var(--gold)}
.field{display:flex;flex-direction:column;gap:4px}
.field label{font-size:12px;color:var(--muted);font-weight:600}
.field input,.field select,.field textarea{background:var(--night);border:1px solid var(--line);border-radius:7px;padding:7px 9px;width:100%}
.field textarea{min-height:80px;resize:vertical}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.phedit{display:flex;flex-direction:column;gap:10px}
.phrow{display:grid;grid-template-columns:64px 1fr auto;gap:8px;align-items:start}
.phrow img{width:64px;height:48px;object-fit:cover;border-radius:6px}
.phrow .f{display:flex;flex-direction:column;gap:4px}
.phrow input,.phrow textarea{background:var(--night);border:1px solid var(--line);border-radius:7px;padding:5px 8px;width:100%;font-size:13px}
.phrow textarea{min-height:44px;resize:vertical}
.row{display:flex;flex-wrap:wrap;gap:8px}
.filebtn{position:relative;overflow:hidden}
.filebtn input{position:absolute;inset:0;opacity:0;cursor:pointer}
@media (max-width:820px){
  .box{grid-template-columns:1fr}
  .two{grid-template-columns:1fr}
}
</style>
</head>
