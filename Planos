  punto:['Punto','<circle cx="12" cy="10" r="3"/><path d="M12 21s-7-6.5-7-11a7 7 0 0 1 14 0c0 4.5-7 11-7 11z"/>']
};
function svg(k){var i=ICONS[k]||ICONS.punto;return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+i[1]+'</svg>';}
function esc(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];});}
function cat(id){for(var i=0;i<S.categories.length;i++){if(S.categories[i].id===id)return S.categories[i];}return {id:id,label:"Otra",color:"#c9cfdb"};}
function pIdx(id){for(var i=0;i<S.points.length;i++){if(S.points[i].id===id)return i;}return -1;}
function pt(id){var i=pIdx(id);return i<0?null:S.points[i];}
function uid(p){return p+Math.random().toString(36).slice(2,9);}
function src(id){return S.images[id]||"";}
function markDirty(){if(!ui.dirty){ui.dirty=true;renderBars();}}
function each(root,sel,fn){Array.prototype.forEach.call(root.querySelectorAll(sel),fn);}

/* ---------- Render ---------- */
function render(){
  app.innerHTML =
    '<header class="wrap top"><div><p class="eyebrow">'+esc(S.eyebrow)+'</p><h1>'+esc(S.title)+'</h1><p class="sub">'+esc(S.subtitle)+'</p></div>'+
    '<div class="top-actions"><span id="topedit"></span></div></header>'+
    '<main class="wrap'+(ui.editing?' editing':'')+'"><div id="bars"></div>'+
    '<div class="mapscroll"><div class="map'+(ui.placing?' placing':'')+'" id="map"><img src="'+src(S.mapImage)+'" alt="Plano general del evento"></div></div>'+
    '<p class="hint" id="hint"></p><div class="pts" id="pts"></div></main>';
  renderBars(); renderMarkers(); renderIndex(); bindMap(); renderModal();
}
function renderBars(){
  var t=document.getElementById("topedit"), b=document.getElementById("bars"), h=document.getElementById("hint");
  if(!t)return;
  t.innerHTML = ui.editing ? '' : ((dl?'<button class="btn ghost" id="b-dl" type="button">Descargar HTML</button>':'')+(window.claude?'<button class="btn" id="b-edit" type="button">Editar plano</button>':''));
  var dlb=document.getElementById("b-dl"); if(dlb)dlb.onclick=downloadHtml;
  var html="";
  if(ui.editing){
    html+='<div class="editbar"><span class="msg">'+(ui.placing?'Haz clic en el plano donde va el nuevo ícono.':'Modo edición: arrastra los íconos para moverlos, haz clic en uno para cambiar su información y fotos.')+'</span>'+
      '<button class="btn small" id="b-add" type="button">'+(ui.placing?'Cancelar':'Añadir ícono')+'</button>'+
      '<button class="btn small ghost" id="b-discard" type="button">Descartar cambios</button>'+
      '<button class="btn small primary" id="b-save" type="button"'+(ui.saving?' disabled':'')+'>'+(ui.saving?'Guardando…':(ui.dirty?'Guardar cambios':'Salir de edición'))+'</button></div>';
  }
  if(ui.status){html+='<div class="status '+ui.status.kind+'">'+esc(ui.status.text)+'</div>';}
  b.innerHTML=html;
  h.textContent = ui.editing ? 'Arrastra un ícono para reubicarlo; haz clic en él para editarlo.' : 'Haz clic en cualquier ícono del mapa para ver sus fotos y su información.';
  var e=document.getElementById("b-edit"); if(e)e.onclick=function(){ui.editing=true;ui.status=null;render();};
  var a=document.getElementById("b-add"); if(a)a.onclick=function(){ui.placing=!ui.placing;render();};
  var d=document.getElementById("b-discard"); if(d)d.onclick=function(){ if(ui.dirty){S=JSON.parse(document.getElementById("state").textContent);} ui.editing=false;ui.placing=false;ui.dirty=false;ui.status=null;ui.open=null;render();};
  var s=document.getElementById("b-save"); if(s)s.onclick=save;
}
function renderMarkers(){
  var m=document.getElementById("map");
  each(m,".mk",function(p){p.remove();});
  S.points.forEach(function(p){
    var b=document.createElement("button");
    b.type="button"; b.className="mk"; b.dataset.id=p.id;
    b.style.left=p.x+"%"; b.style.top=p.y+"%"; b.style.setProperty("--c",cat(p.cat).color);
    b.setAttribute("aria-label",p.name);
    b.innerHTML=svg(p.icon)+(p.num?'<span class="no">'+esc(p.num)+'</span>':'')+'<span class="tag">'+esc(p.name)+'</span>';
    m.appendChild(b);
  });
}
function renderIndex(){
  var el=document.getElementById("pts");
  el.innerHTML=S.categories.map(function(c){
    var ps=S.points.filter(function(p){return p.cat===c.id;});
    if(!ps.length)return "";
    return '<div class="ptgroup"><h3><i class="dot" style="background:'+c.color+'"></i>'+esc(c.label)+'</h3>'+
      ps.map(function(p){return '<button class="pt" type="button" data-open="'+p.id+'" style="--c:'+c.color+'"><i>'+svg(p.icon)+'</i>'+(p.num?esc(p.num)+'. ':'')+esc(p.name)+'</button>';}).join("")+'</div>';
  }).join("");
  each(el,"[data-open]",function(b){b.onclick=function(){openPoint(b.dataset.open);};});
}

function downloadHtml(){
  if(!dl)return;
  dl.save({filename:"planimetria-fin-de-ano-uniandes.html",data:new Blob([buildDoc()])}).then(function(){
    ui.status={kind:"ok",text:"Archivo HTML listo. Puedes subirlo a cualquier hosting para compartirlo con un enlace."};renderBars();
  },function(err){var c=err&&err.code; if(c==="declined")return; ui.status={kind:"err",text:"No se pudo descargar el archivo ("+(c||"error")+"). Intenta de nuevo."};renderBars();});
}

/* ---------- Ventana ---------- */
function openPoint(id){ui.open=id;ui.ph=0;renderModal();}
function closeModal(){ui.open=null;renderModal();}
function renderModal(){
  var old=document.getElementById("modal"); if(old)old.remove();
  document.body.classList.toggle("locked",!!ui.open);
  var p=ui.open?pt(ui.open):null;
  if(!p){ui.open=null;document.body.classList.remove("locked");return;}
  var c=cat(p.cat), n=p.photos.length;
  if(n) ui.ph=((ui.ph%n)+n)%n;
  var cur=n?p.photos[ui.ph]:null;
  var gal = n
    ? '<div class="stage"><img src="'+src(cur.img)+'" alt="'+esc(cur.title)+'">'+(n>1?'<button class="nav prev" type="button" aria-label="Foto anterior">‹</button><button class="nav next" type="button" aria-label="Foto siguiente">›</button>':'')+'<span class="count">'+(ui.ph+1)+' / '+n+'</span></div>'+
      '<div class="cap"><b>'+esc(cur.title)+'</b>'+(cur.desc?'<span>'+esc(cur.desc)+'</span>':'')+'</div>'+
      (n>1?'<div class="thumbs">'+p.photos.map(function(f,i){return '<button type="button" data-ph="'+i+'" class="'+(i===ui.ph?'on':'')+'" aria-label="Ver foto '+(i+1)+'"><img src="'+src(f.img)+'" alt=""></button>';}).join("")+'</div>':'')
    : '<div class="nophoto">'+(ui.editing?'Añade fotos desde el formulario.':'Este punto aún no tiene fotos.')+'</div>';
  var info = ui.editing ? editForm(p) :
    '<div><h2>'+esc(p.name)+'</h2><span class="chip"><i class="dot" style="background:'+c.color+'"></i>'+esc(c.label)+'</span></div>'+
    (p.desc?'<p class="desc">'+esc(p.desc)+'</p>':'')+
    '';
  var d=document.createElement("div"); d.className="modal"; d.id="modal";
  d.innerHTML='<div class="box" role="dialog" aria-modal="true" aria-label="'+esc(p.name)+'"><div class="gal">'+gal+'</div><div class="info"><button class="x" type="button" aria-label="Cerrar">✕</button>'+info+'</div></div>';
  document.body.appendChild(d);
  d.onclick=function(e){if(e.target===d)closeModal();};
  d.querySelector(".x").onclick=closeModal;
  var pv=d.querySelector(".prev"),nx=d.querySelector(".next");
  if(pv)pv.onclick=function(){ui.ph--;renderModal();};
  if(nx)nx.onclick=function(){ui.ph++;renderModal();};
  each(d,"[data-ph]",function(b){b.onclick=function(){ui.ph=+b.dataset.ph;renderModal();};});
  if(ui.editing)bindEdit(d,p);
  else d.querySelector(".x").focus();
}
function editForm(p){
  return '<h2>Editar ícono</h2>'+
  '<div class="field"><label for="f-name">Nombre</label><input id="f-name" data-f="name" value="'+esc(p.name)+'"></div>'+
  '<div class="two"><div class="field"><label for="f-cat">Función</label><select id="f-cat" data-f="cat">'+S.categories.map(function(c){return '<option value="'+c.id+'"'+(c.id===p.cat?' selected':'')+'>'+esc(c.label)+'</option>';}).join("")+'</select></div>'+
  '<div class="field"><label for="f-icon">Ícono</label><select id="f-icon" data-f="icon">'+Object.keys(ICONS).map(function(k){return '<option value="'+k+'"'+(k===p.icon?' selected':'')+'>'+esc(ICONS[k][0])+'</option>';}).join("")+'</select></div></div>'+
  '<div class="field"><label for="f-num">Número en el ícono (opcional)</label><input id="f-num" data-f="num" value="'+esc(p.num||"")+'"></div>'+
  '<div class="field"><label for="f-desc">Descripción</label><textarea id="f-desc" data-f="desc">'+esc(p.desc)+'</textarea></div>'+
  '<h3>Fotos</h3><div class="phedit">'+p.photos.map(function(f,i){
    return '<div class="phrow"><img src="'+src(f.img)+'" alt=""><div class="f"><input id="pt-'+i+'" data-pf="'+i+':title" value="'+esc(f.title)+'" aria-label="Título de la foto"><textarea id="pd-'+i+'" data-pf="'+i+':desc" aria-label="Descripción de la foto">'+esc(f.desc)+'</textarea></div><button class="btn small danger" type="button" data-pdel="'+i+'">Quitar</button></div>';
  }).join("")+'</div>'+
  '<div class="row"><span class="btn small filebtn">Añadir fotos<input type="file" accept="image/*" multiple id="up" aria-label="Añadir fotos"></span><button class="btn small danger" type="button" id="b-delp">Eliminar este ícono</button></div>';
}
function bindEdit(d,p){
  each(d,"[data-f]",function(el){
    el.addEventListener(el.tagName==="SELECT"?"change":"input",function(){p[el.dataset.f]=el.value;markDirty();renderMarkers();renderIndex();});
  });
  each(d,"[data-pf]",function(el){el.oninput=function(){var a=el.dataset.pf.split(":");p.photos[+a[0]][a[1]]=el.value;markDirty();};});
  each(d,"[data-pdel]",function(b){b.onclick=function(){p.photos.splice(+b.dataset.pdel,1);markDirty();renderModal();};});
  d.querySelector("#up").onchange=function(){addFiles(p,this.files);};
  var del=d.querySelector("#b-delp");
  del.onclick=function(){
    if(del.dataset.sure){S.points.splice(pIdx(p.id),1);ui.open=null;markDirty();render();}
    else{del.dataset.sure="1";del.textContent="Confirmar: eliminar ícono";}
  };
}
function addFiles(p,files){
  var list=Array.prototype.slice.call(files||[]); if(!list.length)return;
  var left=list.length;
  function done(){if(--left===0){markDirty();renderModal();renderIndex();}}
  list.forEach(function(f){
    var r=new FileReader();
    r.onload=function(){
      var im=new Image();
      im.onload=function(){
        var k=Math.min(1,1200/Math.max(im.width,im.height));
        var c=document.createElement("canvas"); c.width=Math.round(im.width*k); c.height=Math.round(im.height*k);
        c.getContext("2d").drawImage(im,0,0,c.width,c.height);
        var id=uid("i"); S.images[id]=c.toDataURL("image/jpeg",0.8);
        p.photos.push({img:id,title:f.name.replace(/\.[^.]+$/,""),desc:""});
        done();
      };
      im.onerror=done; im.src=r.result;
    };
    r.onerror=done; r.readAsDataURL(f);
  });
}
document.addEventListener("keydown",function(e){
  if(!ui.open)return;
  var tag=(e.target&&e.target.tagName)||"";
  if(e.key==="Escape")closeModal();
  else if(!/INPUT|TEXTAREA|SELECT/.test(tag)){
    if(e.key==="ArrowLeft"){ui.ph--;renderModal();}
    else if(e.key==="ArrowRight"){ui.ph++;renderModal();}
  }
});

/* ---------- Mapa: clic, arrastre, nuevo ícono ---------- */
function bindMap(){
  var m=document.getElementById("map"), drag=null;
  m.addEventListener("pointerdown",function(e){
    var mk=e.target.closest(".mk"); if(!mk||!ui.editing)return;
    drag={id:mk.dataset.id,el:mk,x0:e.clientX,y0:e.clientY,moved:false};
    mk.setPointerCapture(e.pointerId);
  });
  m.addEventListener("pointermove",function(e){
    if(!drag)return;
    if(!drag.moved&&Math.abs(e.clientX-drag.x0)+Math.abs(e.clientY-drag.y0)<4)return;
    drag.moved=true;
    var r=m.getBoundingClientRect(), p=pt(drag.id);
    p.x=+Math.max(0,Math.min(100,(e.clientX-r.left)/r.width*100)).toFixed(2);
    p.y=+Math.max(0,Math.min(100,(e.clientY-r.top)/r.height*100)).toFixed(2);
    drag.el.style.left=p.x+"%"; drag.el.style.top=p.y+"%";
  });
  m.addEventListener("pointerup",function(){if(drag&&drag.moved){markDirty();drag.el.dataset.moved="1";}drag=null;});
  m.addEventListener("click",function(e){
    var mk=e.target.closest(".mk");
    if(mk){if(mk.dataset.moved){delete mk.dataset.moved;return;}openPoint(mk.dataset.id);return;}
    if(ui.editing&&ui.placing){
      var r=m.getBoundingClientRect();
      var p={id:uid("p"),name:"Nuevo punto",cat:S.categories[0].id,icon:"punto",num:"",x:+((e.clientX-r.left)/r.width*100).toFixed(2),y:+((e.clientY-r.top)/r.height*100).toFixed(2),desc:"",notes:"",photos:[]};
      S.points.push(p); ui.placing=false; markDirty(); render(); openPoint(p.id);
    }
  });
}

/* ---------- Guardar ---------- */
function buildDoc(){
  var css=document.getElementById("app-css").textContent;
  var js=document.getElementById("app-js").textContent;
  var json=JSON.stringify(S).replace(/</g,"\\u003c");
  return '<!DOCTYPE html>\n<html lang="es">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n<title>'+esc(document.title)+'<\/title>\n'+
    '<link rel="preconnect" href="https://fonts.googleapis.com">\n<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>\n'+
    '<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">\n'+
    '<style id="app-css">'+css+'<\/style>\n<\/head>\n<body>\n<div id="app"><\/div>\n'+
    '<script id="state" type="application/json">'+json+'<\/script>\n'+
    '<script id="app-js">'+js+'<\/script>\n<\/body>\n<\/html>\n';
}
function save(){
  if(!ui.dirty){ui.editing=false;ui.placing=false;ui.status=null;render();return;}
  if(!art){ui.status={kind:"err",text:"Esta vista no permite guardar. Abre el plano desde su enlace de claude.ai para guardar los cambios."};renderBars();return;}
  ui.saving=true;ui.status=null;ui.dirty=false;renderBars();
  art.publish(buildDoc()).then(function(){
    ui.saving=false;ui.editing=false;ui.status={kind:"ok",text:"Cambios guardados. Todos los que abran el plano verán esta versión."};render();
  },function(err){
    ui.saving=false;ui.dirty=true;
    var code=(err&&(err.code||err.name||err.message))||"";
    var t = /not_writer|not_granted/.test(code) ? "No tienes permiso para guardar este plano. Pídele al propietario que haga los cambios o que te dé permiso de edición."
          : /conflict/.test(code) ? "Alguien guardó otra versión al mismo tiempo. La página se recargará con esa versión; vuelve a hacer tu cambio."
          : "No se pudo guardar ("+code+"). Intenta de nuevo en un momento.";
    ui.status={kind:"err",text:t};renderBars();
  });
}
window.addEventListener("beforeunload",function(e){if(ui.dirty){e.preventDefault();e.returnValue="";}});

render();
try{ if(window.claude&&window.claude.use){ window.claude.use("artifact").then(function(a){art=a;},function(){art=null;}); window.claude.use("downloads").then(function(d){dl=d;if(d)renderBars();},function(){dl=null;}); } }catch(e){art=null;}
})();
</script>
</body>
</html>
